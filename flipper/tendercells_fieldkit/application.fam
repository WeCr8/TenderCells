# Tender Cells Field Kit — external Flipper Zero app (FAP)
# Build with ufbt:  cd flipper/tendercells_fieldkit && ufbt && ufbt launch
App(
    appid="tendercells_fieldkit",
    name="Tender Cells Field Kit",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tendercells_fieldkit_app",
    stack_size=8 * 1024,
    fap_category="Tools",
    fap_author="WeCr8 Solutions",
    fap_version="1.1",
    fap_description="Fail-closed Tender Cells field guidance for UART health, add-on WiFi/frequency boards, offline nodes, and safe GPIO/reed bring-up checks.",
    requires=[
        "gui",
        "expansion",
    ],
)
