#include <Arduino.h>\n#include <ESP32Servo.h>\n#include "HX711.h"\n\nconstexpr int SERVO_PIN = D1;\nconstexpr int HX_DOUT = D2;\nconstexpr int HX_SCK  = D3;\nconstexpr int BUTTON_PIN = D0;\n\nServo feeder;\nHX711 scale;\nfloat calibrationFactor = 1.0f; // replace after calibration\nint homeDeg = 0;\nint pocketDeg = 60;\n\nvoid dispenseOnePocket() {\n  static int pos = 0;\n  pos = (pos + pocketDeg) % 180; // positional servo: mechanical design must operate within actual range\n  feeder.write(pos);\n  delay(700);\n}\n\nvoid setup(){\n  Serial.begin(115200);\n  pinMode(BUTTON_PIN, INPUT_PULLUP);\n  feeder.attach(SERVO_PIN, 500, 2500);\n  feeder.write(homeDeg);\n  scale.begin(HX_DOUT, HX_SCK);\n  scale.set_scale(calibrationFactor);\n  scale.tare();\n}\n\nvoid loop(){\n  if(!digitalRead(BUTTON_PIN)) { dispenseOnePocket(); delay(400); }\n  if(scale.is_ready()) Serial.printf("Feed mass: %.1f g\\n", scale.get_units(5));\n  delay(200);\n}\n