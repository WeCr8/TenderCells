{
  "expo": {
    "name": "TenderCells",
    "slug": "tendercells-preview",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.wecr8.tendercells.preview",
      "supportsTablet": true
    },
    "android": {
      "package": "com.wecr8.tendercells.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }]
    ]
  }
}
