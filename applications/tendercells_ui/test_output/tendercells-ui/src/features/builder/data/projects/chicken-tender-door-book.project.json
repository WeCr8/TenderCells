      "step_asset": "books/chicken-tender-door/page_03.webp",
      "view": "page"
     },
     "safety": [
      "CHILD_OK"
     ]
    },
    {
     "id": "d02",
     "type": "concept",
     "action": "Check the box",
     "instruction": "Check you have every part: controller and expansion board, 12 V linear actuator, limit switch, weatherproof enclosure, 12 V power supply, door brackets A and B, wires, screws and zip ties. The camera and DHT22 sensor are optional.",
     "image": {
      "step_asset": "books/chicken-tender-door/page_04.webp",
      "view": "page"
     },
     "safety": [
      "CHILD_OK"
     ]
