   "title": "Meet your project",
   "steps": [
    {
     "id": "d01",
     "type": "concept",
     "action": "Meet your project",
     "instruction": "You will build a smart coop door that opens and closes by itself, keeps your chickens safe and connects to Tender Cells OS.",
