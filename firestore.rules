rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns a document (has userId field matching auth.uid)
    function isOwner(userId) {
      return isAuthenticated() && userId == request.auth.uid;
    }
    
    // Helper function to check if user is creating/updating with their own userId
    function isCreatingOwnData() {
      return isAuthenticated() && 
             request.resource.data.userId == request.auth.uid;
    }

    function isOwnedResource() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function keepsOwner() {
      return isAuthenticated() &&
             resource.data.userId == request.auth.uid &&
             request.resource.data.userId == request.auth.uid;
    }

    function deviceDoc(deviceId) {
      return get(/databases/$(database)/documents/devices/$(deviceId));
    }

    function ownsDevice(deviceId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/devices/$(deviceId)) &&
             deviceDoc(deviceId).data.userId == request.auth.uid;
    }

    function deviceItemCreateMatches(deviceId) {
      return ownsDevice(deviceId) &&
             request.resource.data.deviceId == deviceId;
    }

    // ── Organizations (schools, districts, farms) - see shared/org/orgModel.ts ──
    // An org owns properties/products (docs carry orgId). Members read what their
    // classes allow; the allowed* lists on the member doc are kept in sync by the
    // syncClassAccess Cloud Function (admin SDK). Students never create their own.
    function memberPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }
    function isOrgMember(orgId) {
      return isAuthenticated() && exists(memberPath(orgId));
    }
    function isOrgStaff(orgId) {
      return isOrgMember(orgId) && get(memberPath(orgId)).data.role in ['owner', 'admin'];
    }
    function orgAllows(orgId, listField, id) {
      return isOrgMember(orgId) && id in get(memberPath(orgId)).data.get(listField, []);
    }
    function orgCanRead(listField, id) {
      return isAuthenticated() && resource.data.get('orgId', null) != null &&
             (isOrgStaff(resource.data.orgId) || orgAllows(resource.data.orgId, listField, id));
    }
    // School-managed student accounts (custom claim set by the SSO backend).
    function isStudentAccount() {
      return isAuthenticated() && request.auth.token.get('accountType', '') == 'student';
    }
    // Personal create (userId = me, no orgId) or org create by that org's staff.
    function canCreateAsset() {
      return isCreatingOwnData() && !isStudentAccount() &&
             (request.resource.data.get('orgId', null) == null || isOrgStaff(request.resource.data.orgId));
    }

    function deviceItemKeepsDevice(deviceId) {
      return ownsDevice(deviceId) &&
             resource.data.deviceId == deviceId &&
             request.resource.data.deviceId == deviceId;
    }

    // Properties collection
    // Users can only read/write their own properties
    match /properties/{propertyId} {
      // Owner, or a member of the owning org whose classes include this property.
      allow read: if isOwnedResource() || orgCanRead('allowedPropertyIds', propertyId);

      // Personal property, or an org property created by org staff. Never students.
      allow create: if canCreateAsset();
      
      // Allow update if user owns the property
      allow update: if keepsOwner();
      
      // Allow delete if user owns the property
      allow delete: if isOwnedResource();
    }

    // Placements collection
    // Users can read/write placements for properties they own
    match /placements/{placementId} {
      allow read: if isAuthenticated() &&
                     exists(/databases/$(database)/documents/properties/$(resource.data.propertyId)) &&
                     get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
                       get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/properties/$(resource.data.propertyId)) &&
                       get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.userId == request.auth.uid &&
                       request.resource.data.propertyId == resource.data.propertyId;
      allow delete: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/properties/$(resource.data.propertyId)) &&
                       get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.userId == request.auth.uid;
    }

    // User profiles/settings collection
    // Users can only manage their own profile data
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile
      allow create: if isCreatingOwnData();
      
      // Users can update their own profile
      allow update: if isOwner(userId) && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own profile
      allow delete: if isOwner(userId);
    }

    // User settings collection
    // Users can only manage their own settings
    match /user_settings/{userId} {
      // Users can read their own settings
      allow read: if isOwner(userId);
      
      // Users can create their own settings
      allow create: if isCreatingOwnData();
      
      // Users can update their own settings
      allow update: if isOwner(userId) && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own settings
      allow delete: if isOwner(userId);
    }

    // Products collection (if stored in Firestore)
    // Users can manage products associated with their properties
    match /products/{productId} {
      allow read: if isOwnedResource() || orgCanRead('allowedProductIds', productId);
      allow create: if canCreateAsset();
      allow update: if keepsOwner();
      allow delete: if isOwnedResource();
    }

    // Devices collection (if stored in Firestore)
    // Users can manage their own devices
    match /devices/{deviceId} {
      allow read: if isOwnedResource() || orgCanRead('allowedProductIds', deviceId);

      // Allow create if user sets their own userId (org devices: org staff; never students)
      allow create: if canCreateAsset();
      
      // Allow update if user owns the device
      allow update: if keepsOwner();
      
      // Allow delete if user owns the device
      allow delete: if isOwnedResource();
    }

    // User preferences/notifications collection
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Account data collection
    match /accounts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Settings collection (general app settings per user)
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Animals collection (birds, chickens, etc.)
    // Users can manage animals linked to their properties and products
    match /animals/{animalId} {
      // Allow read if user owns the animal
      allow read: if isOwnedResource();
      
      // Allow create if user is authenticated and sets their own userId
      allow create: if isCreatingOwnData();
      
      // Allow update if user owns the animal
      allow update: if keepsOwner();
      
      // Allow delete if user owns the animal
      allow delete: if isOwnedResource();
    }

    // Per-device rosters used by the current app:
    // birds/{deviceId}/items/{birdId}
    match /birds/{deviceId}/items/{birdId} {
      allow read, delete: if ownsDevice(deviceId);
      allow create: if ownsDevice(deviceId) &&
                       (!('device' in request.resource.data) || request.resource.data.device == deviceId);
      allow update: if ownsDevice(deviceId) &&
                       (!('device' in resource.data) || resource.data.device == deviceId) &&
                       (!('device' in request.resource.data) || request.resource.data.device == deviceId);
    }

    // Per-device automation schedules used by the current app:
    // schedules/{deviceId}/items/{scheduleId}
    match /schedules/{deviceId}/items/{scheduleId} {
      allow read, delete: if ownsDevice(deviceId);
      allow create: if deviceItemCreateMatches(deviceId);
      allow update: if deviceItemKeepsDevice(deviceId);
    }

    // Organizations. Plans change only through billing (server), never from clients.
    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isAuthenticated() && !isStudentAccount() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.plan == 'free';
      allow update: if isOrgStaff(orgId) &&
                       request.resource.data.plan == resource.data.plan &&
                       request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isOwner(uid) || isOrgStaff(orgId);
        // The org's creator adds themself as owner; staff manage everyone else.
        allow create: if (isOwner(uid) && request.resource.data.role == 'owner' &&
                          get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid) ||
                         (isOrgStaff(orgId) && request.resource.data.role != 'owner');
        allow update: if isOrgStaff(orgId) && request.resource.data.role != 'owner' && resource.data.role != 'owner';
        allow delete: if isOrgStaff(orgId) && resource.data.role != 'owner';
      }

      match /classes/{classId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgStaff(orgId);
      }

      // Plan-limit and other notices written by Cloud Functions.
      match /notices/{noticeId} {
        allow read: if isOrgStaff(orgId);
        allow write: if false;
      }

      // Accounts whose email domain matches the org, waiting for staff to approve.
      match /joinRequests/{uid} {
        allow read: if isOwner(uid) || isOrgStaff(orgId);
        allow delete: if isOrgStaff(orgId);
        allow create, update: if false; // written by the onUserCreated Cloud Function
      }
    }

    // Newsletter sign-up (double opt-in): anyone may request; nobody reads from a client.
    match /newsletterSignups/{signupId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'topics', 'source', 'status', 'createdAt']) &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() <= 254 &&
                       request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
                       request.resource.data.topics is list && request.resource.data.topics.size() <= 10 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Confirmed newsletter subscribers - managed by Cloud Functions only.
    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if false;
    }

    // School pilot / sign-up inquiries from tendercells.com/schools.
    match /schoolInquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['school', 'district', 'contactName', 'email', 'role',
                         'students', 'sso', 'notes', 'createdAt', 'uid']) &&
                       request.resource.data.school is string && request.resource.data.school.size() > 1 &&
                       request.resource.data.school.size() <= 200 &&
                       request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
                       request.resource.data.get('notes', '').size() <= 2000 &&
                       request.resource.data.createdAt == request.time &&
                       (request.resource.data.get('uid', null) == null ||
                        (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }

    // Billing records are written by the billing backend only; owners can read theirs.
    match /billing/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Outgoing email queue (Firebase "Trigger Email" extension). Server-only.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Fallback: Deny access to any other collections by default
    // Add specific rules above for any new collections you create
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
