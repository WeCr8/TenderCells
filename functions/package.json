{
  "name": "tender-cells-functions",
  "description": "Firebase Cloud Functions for Tender Cells",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc && node scripts/build-connector.mjs",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "lint": "eslint ."
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "~1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    }
  }
}
