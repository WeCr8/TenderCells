# Environment Variables Example
# Copy this file to .env and replace with your actual API keys

# Firebase Configuration (Already configured)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Maps Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Places API (for enhanced search)
# Enable Places API in Google Cloud Console
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Geolocation API Configuration
VITE_ENABLE_GEOLOCATION=true
VITE_DEFAULT_LATITUDE=39.8283
VITE_DEFAULT_LONGITUDE=-98.5795

# Map Configuration
VITE_DEFAULT_ZOOM_LEVEL=10
VITE_MAX_SEARCH_RADIUS=50
VITE_MAP_THEME=standard

# Service Search Configuration
VITE_MAX_SEARCH_RESULTS=20
VITE_ENABLE_DISTANCE_FILTER=true
VITE_ENABLE_RATING_FILTER=true

# Analytics Configuration
VITE_TRACK_MAP_INTERACTIONS=true
VITE_TRACK_SERVICE_CLICKS=true

# Development Configuration
VITE_DEBUG_MODE=false
VITE_MOCK_LOCATION_DATA=false

# Tender Cells Hardware Configuration
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883
MQTT_DEVICE_ID=chicken_tender_001

# Claude AI Integration (Cloud Functions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API Setup Instructions:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing project
# 3. Enable the following APIs:
#    - Maps JavaScript API
#    - Places API
#    - Geocoding API
#    - Geolocation API
# 4. Create credentials (API Key)
# 5. Restrict the API key to your domain for security
# 6. Copy the API key to VITE_GOOGLE_MAPS_API_KEY above

# Required APIs for full functionality:
# - Maps JavaScript API: For map display
# - Places API: For service search
# - Geocoding API: For address to coordinates conversion
# - Geolocation API: For current location detection
