{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tendercells.com/schema/roost-observation-v1.json",
  "title": "TenderCells Roost Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "propertyId",
    "localDate",
    "sourceType",
    "confidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "propertyId": {
      "type": "string"
    },
    "localDate": {
      "type": "string",
      "format": "date"
    },
    "roostingSeenBy": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confirmedFirstRoostAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastBirdInsideAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "shadeOnsetAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lux": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "sourceType": {
      "enum": [
        "human_report",
        "sensed",
        "inferred",
        "simulated"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
