# Frontend
VITE_API_BASE_URL=http://localhost:5173/api
VITE_SIM_MODE=true

# Hardware-control API (express-api MQTT bridge) — MUST match where the API runs.
# Default API port is 4000, but 4000 is phantom-reserved on Windows — use 4100 there.
VITE_MQTT_API_BASE_URL=http://localhost:4100/api/mqtt

# Firebase (real login + device ownership). MUST be the SAME project the express-api
# Admin SDK uses, or token verification fails (401). Leave blank for demo/sim mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend
API_PORT=4000

# 3D Model Storage
VITE_MODEL_STORAGE_URL=http://localhost:5173/models
MAX_MODEL_FILE_SIZE=50MB
