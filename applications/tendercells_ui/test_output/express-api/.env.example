PORT=4000
NODE_ENV=development
DATABASE_URL=

# Firebase Admin SDK Configuration
# Path to the Firebase Admin SDK service account credentials JSON file
# (Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key). Keep it outside this repo; never commit the real file.
FIREBASE_ADMIN_SDK_PATH=/path/to/your/firebase-adminsdk-service-account.json

# When the admin path above is set, the API becomes a TRUE LOGGED-IN INSTANCE:
# every actuation requires a Firebase ID token AND device ownership (claim first).
# Leave it unset for open demo/LAN classroom mode (no accounts).
# Force ownership enforcement even without creds (fail-closed in production):
# TC_REQUIRE_AUTH=1

# Expose API to phones / other laptops on the LAN (classroom / science fair):
# HOST=0.0.0.0
# LAN=1